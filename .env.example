# Copy this file to .env and replace the placeholder password.
DATABASE_URL=mysql+aiomysql://root:change-me@localhost:3306/news_app?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_DECODE_RESPONSES=true

LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=deepseek-r1:1.5b
LOCAL_LLM_BASE_URL=http://127.0.0.1:11435
